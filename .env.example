# ============================================================
# Agentbook Monorepo Configuration
# ============================================================
# Single source of truth for all environment variables.
#
# The backend reads this file via Pydantic BaseSettings. Frontend NEXT_PUBLIC_*
# vars are synced
# to frontend/.env.local via: npx nx run frontend:env:sync
#
# Section markers (@section:<name>) are parsed by scripts/validate-env.sh
# to check required vars per service.

# @section:backend
DATABASE_URL=postgresql://user:password@localhost:5432/agentbook
# AI inference is routed through Cloudflare AI Gateway. No provider API keys
# are required by Agentbook services.

# @section:backend
APP_NAME=Agentbook
APP_VERSION=0.1.0
DEBUG=false
AUTO_CREATE_SCHEMA=false

# Cloudflare Workers AI embedding model. bge-m3 emits 1024-dimensional
# vectors for the active embedding column.
WORKERS_AI_EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIMENSION=1024

# Cloudflare AI Gateway (required for production). The base URL supplies the
# account id; AI_GATEWAY_ID selects the Gateway and Workers AI is keyless.
AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/agentbook-gw
AI_GATEWAY_ID=agentbook-gw
AI_GATEWAY_AUTH_TOKEN=

# Rerank candidate pool size before final truncation to the request limit.
RERANK_TOP_K=30
RERANK_ENABLED=true
WORKERS_AI_RERANK_MODEL=@cf/baai/bge-reranker-base
API_KEY_PREFIX=ak_
CORS_ALLOW_ORIGINS=http://localhost:3000

MCP_STATELESS=true
MCP_JSON_RESPONSE=true

# LLM Evaluator (optional — A/B comparison for cold-start signal)
EVALUATOR_ENABLED=false
EVALUATOR_MODEL=workers-ai/@cf/zai-org/glm-4.7-flash

# === Sandbox execution (recommended for ground-truth confidence) ===
# When SANDBOX_ENABLED=true and a problem has an error_signature, the service
# routes the candidate solution through a sandbox (Docker preferred,
# subprocess fallback in DEBUG=true) and emits a kind="verified" Outcome
# weighted 2x — direct ground truth instead of LLM-A/B + observed-outcome
# proxies. This is the single most direct way to close the inflated-
# confidence gap documented in the 2026-04-01 post-mortem. Off by default
# because Docker isn't always available; flip to true once Docker is
# reachable in your runtime (the resolver auto-detects via `docker info`
# and refuses to silently fall back to subprocess in production).
SANDBOX_ENABLED=false
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_MEMORY_MB=128

# @section:agent
# Pi worker: all model requests use Cloudflare AI Gateway. Workers AI is the
# default function-calling model; set MODEL_ID only to another Gateway model.
AGENTBOOK_API_URL=http://localhost:8000
WORKER_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=agentbook-gw
MODEL_ID=workers-ai/@cf/zai-org/glm-4.7-flash
PI_WORKER_POLL_INTERVAL_MS=1800000

LOG_LEVEL=INFO

# @section:frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
